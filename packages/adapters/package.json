{
  "name": "@lumina/adapters",
  "version": "1.0.0-alpha",
  "description": "UI Scan and Execution Adapters (DOM, Playwright, etc.) for Lumina.js",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lumina/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "*"
  },
  "keywords": ["lumina", "adapters", "dom", "playwright"],
  "license": "MIT"
}
