{
  "name": "@lumina/core",
  "version": "1.0.0-alpha",
  "description": "Planner, LLM Orchestrator, Prompt Builder, Tool Router, Escalation Pipeline",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lumina/contracts": "workspace:*",
    "@lumina/workflow": "workspace:*",
    "@lumina/memory": "workspace:*",
    "@lumina/security": "workspace:*",
    "@lumina/retrieval": "workspace:*",
    "@lumina/adapters": "workspace:*",
    "@lumina/tools": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "keywords": ["lumina", "core", "planner", "llm", "orchestrator"],
  "license": "MIT"
}
